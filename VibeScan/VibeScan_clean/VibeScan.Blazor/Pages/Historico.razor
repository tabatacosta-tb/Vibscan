@page "/historico"
@inject VibeScan.Blazor.Services.VibeScanApiService Api
@inject NavigationManager Nav

<PageTitle>VibeScan — Histórico</PageTitle>

<div class="vs-page">
    <header class="vs-hero vs-hero--sm">
        <h1 class="vs-hero__title">Histórico de <span class="vs-hero__accent">Análises</span></h1>
        <p class="vs-hero__sub">Todas as análises realizadas nesta sessão.</p>
    </header>

    @if (Carregando)
    {
        <div class="vs-loading-center">
            <span class="vs-spinner vs-spinner--lg" />
            <p>Carregando histórico...</p>
        </div>
    }
    else if (!Itens.Any())
    {
        <div class="vs-empty">
            <span class="vs-empty__icon">⬡</span>
            <p>Nenhuma análise realizada ainda.</p>
            <a href="/" class="vs-btn vs-btn--primary">Fazer primeira análise</a>
        </div>
    }
    else
    {
        <div class="vs-historico-grid">
            @foreach (var item in Itens)
            {
                <div class="vs-historico-card" @onclick="() => VerDetalhe(item.Id)">
                    <div class="vs-historico-card__header">
                        <div class="vs-score-badge" style="background: @(item.Cor ?? "#6b7280")">
                            <span class="vs-score-badge__valor">@(item.Score?.ToString() ?? "—")</span>
                            <span class="vs-score-badge__label">@(item.Classificacao ?? "—")</span>
                        </div>
                        <span class="vs-status vs-status--@item.Status.ToLower()">@item.Status</span>
                    </div>
                    <div class="vs-historico-card__body">
                        <div class="vs-historico-card__meta">
                            <span>@item.TotalProblemas problemas encontrados</span>
                            @if (item.ProblemasCriticos > 0)
                            {
                                <span class="vs-badge vs-badge--critico">@item.ProblemasCriticos críticos</span>
                            }
                        </div>
                        <time class="vs-historico-card__date">
                            @item.CriadoEm.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                        </time>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<VibeScan.Blazor.Models.HistoricoItem> Itens { get; set; } = new();
    private bool Carregando { get; set; } = true;

    protected override async Task OnInitializedAsync()
    {
        try   { Itens = await Api.ObterHistoricoAsync(); }
        catch { /* silencioso na listagem */ }
        finally { Carregando = false; }
    }

    private void VerDetalhe(Guid id) => Nav.NavigateTo($"/analise/{id}");
}
