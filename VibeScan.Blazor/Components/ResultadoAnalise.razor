@using VibeScan.Blazor.Models

<div class="vs-resultado">

    @* Score + Resumo *@
    <div class="vs-resultado__header">
        <div class="vs-score-ring" style="--score-color: @Analise.Score.Cor">
            <svg viewBox="0 0 64 64" class="vs-score-ring__svg">
                <circle cx="32" cy="32" r="28" class="vs-score-ring__bg" />
                <circle cx="32" cy="32" r="28" class="vs-score-ring__fill"
                        style="stroke-dashoffset: @ScoreDashOffset" />
            </svg>
            <div class="vs-score-ring__label">
                <span class="vs-score-ring__valor">@Analise.Score.Valor</span>
                <span class="vs-score-ring__max">/10</span>
            </div>
        </div>

        <div class="vs-resultado__resumo">
            <span class="vs-badge-classificacao" style="background: @Analise.Score.Cor">
                @Analise.Score.Classificacao
            </span>
            <p class="vs-resultado__resumo-texto">@Analise.ResumoExecutivo</p>
        </div>
    </div>

    @* Problemas por categoria *@
    <section class="vs-section">
        <h3 class="vs-section__title">Problemas Encontrados
            <span class="vs-section__count">@Analise.Problemas.Count</span>
        </h3>

        @foreach (var grupo in ProblemasAgrupados)
        {
            <div class="vs-grupo">
                <h4 class="vs-grupo__titulo vs-grupo__titulo--@SlugCategoria(grupo.Key)">
                    @IconeCategoria(grupo.Key) @grupo.Key
                </h4>
                @foreach (var p in grupo)
                {
                    <div class="vs-problema vs-problema--@p.Severidade.ToLower()">
                        <div class="vs-problema__header">
                            <span class="vs-severidade vs-severidade--@p.Severidade.ToLower()">
                                @p.Severidade
                            </span>
                        </div>
                        <p class="vs-problema__descricao">@p.Descricao</p>
                        <p class="vs-problema__sugestao">💡 @p.Sugestao</p>
                    </div>
                }
            </div>
        }

        @if (!Analise.Problemas.Any())
        {
            <div class="vs-alert vs-alert--success">
                Nenhum problema encontrado. Código com boas práticas! 🎉
            </div>
        }
    </section>

    @* Arquitetura recomendada *@
    <section class="vs-section">
        <h3 class="vs-section__title">🏗️ Arquitetura Recomendada</h3>
        <div class="vs-card-destaque">
            @Analise.ArquiteturaRecomendada
        </div>
    </section>

    @* Prompt melhorado *@
    <section class="vs-section">
        <h3 class="vs-section__title">✨ Prompt Melhorado</h3>
        <p class="vs-section__desc">Use este prompt no seu vibe coding para gerar um código melhor:</p>
        <div class="vs-prompt-box">
            <pre class="vs-prompt-box__texto">@Analise.PromptMelhorado</pre>
            <button class="vs-btn vs-btn--ghost vs-btn--sm vs-prompt-box__copy"
                    @onclick="CopiarPrompt">
                @(Copiado ? "✓ Copiado!" : "Copiar")
            </button>
        </div>
    </section>

</div>

@code {
    [Parameter, EditorRequired]
    public AnalisarResponse Analise { get; set; } = default!;

    [Inject] private IJSRuntime JS { get; set; } = default!;

    private bool Copiado { get; set; }

    private IEnumerable<IGrouping<string, ProblemaModel>> ProblemasAgrupados =>
        Analise.Problemas.GroupBy(p => p.Categoria);

    // Dashoffset para o SVG circular: circunferência = 2π×28 ≈ 175.9
    private string ScoreDashOffset =>
        (175.9 - (175.9 * Analise.Score.Valor / 10.0)).ToString("F1",
            System.Globalization.CultureInfo.InvariantCulture);

    private static string SlugCategoria(string cat) =>
        cat.ToLower().Replace(" ", "-").Replace("ç", "c").Replace("ã", "a");

    private static string IconeCategoria(string cat) => cat switch
    {
        "Segurança"     => "🔴",
        "Arquitetura"   => "🟠",
        "Performance"   => "🔵",
        _               => "🟡"
    };

    private async Task CopiarPrompt()
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", Analise.PromptMelhorado);
        Copiado = true;
        await Task.Delay(2000);
        Copiado = false;
    }
}
